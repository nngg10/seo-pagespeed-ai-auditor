# Copia este archivo como .env y completa lo que necesites. Todas las claves son opcionales.

# Google PageSpeed Insights (sin clave funciona, pero con un límite bajo de consultas)
PAGESPEED_API_KEY=

# Agente IA: si se define alguna clave se usa ese proveedor (Gemini tiene prioridad).
# Sin clave, las recomendaciones se generan con el motor de reglas local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seguridad JWT (si se deja vacío se genera una clave aleatoria en data/jwt_secret.key)
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

HOST=127.0.0.1
PORT=8000
